#!/bin/bash
#
# rem - a persistent to-do list that can also notify.
#
# One record type: an item with optional due time. No due time is a plain
# to-do; a due time makes it notify once. Firing never completes an item -
# only `done` or `rm` takes it off the list. That is the whole point, and the
# reason this exists alongside `omarchy reminder`, which fires and evaporates.
#
# `rem note` is a second, separate record: a titled sticky note that never
# fires and is never completed. Notes live in their own file, notes.json, and
# reminder commands never open it, so a bad note store cannot touch the list.
#
# This script is the ONLY writer of items.json and notes.json. The overlay and
# the sweeper shell out to it so locking lives in exactly one place.
#
# State I/O is descriptor-anchored: the state directory is opened once on fd 9
# and verified (real directory, owned by us, mode 700, reached without a
# symlink); every later path goes through /dev/fd/9/ so a swap of the on-disk
# directory after the check cannot redirect a read or a write. The store is
# opened on fd 8 and checked the same way before a byte is parsed. The
# directory fd is also the lock, so there is no lock file to race on.

set -euo pipefail
umask 077

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/rem"
GLYPH="󰢌"

# Hard caps. Anything past these is refused (input) or truncated (output), so
# the store, the notification body and `ls --json` all stay bounded no matter
# what is on disk.
MAX_TEXT=500                  # characters of item text
MAX_INPUT=800                 # characters of one add/parse/snooze argument
MAX_ITEMS=500                 # open items
MAX_ARCHIVE=200               # closed items kept for undo
MAX_STORE_BYTES=$((2 * 1024 * 1024))
MAX_NOTIFY_LINES=10
MAX_ID_DIGITS=15

MAX_NOTES=50                  # notes; a note's id is its slot, 1..MAX_NOTES
MAX_NOTE_TITLE=200            # characters of note title
MAX_NOTE_BODY=4000            # characters of note body
MAX_NOTES_BYTES=$((256 * 1024))

# A missed reminder older than this reads as "you were away" rather than "this
# just fired", and gets the grouped catch-up notification instead of a toast.
AWAY_THRESHOLD=300

die() {
  echo "rem: $*" >&2
  exit 1
}

# --- store -------------------------------------------------------------------

# Open the state directory on fd 9 and refuse anything that is not a private
# directory of ours reached without a symlink. After this, DIR is a path that
# resolves through the descriptor, not through the filesystem name.
open_state_dir() {
  [[ -e $STATE_DIR || -L $STATE_DIR ]] || mkdir -p -m 700 "$STATE_DIR"
  exec 9<"$STATE_DIR" || die "cannot open $STATE_DIR"
  local pathid fdid owner mode ftype
  pathid=$(stat -c '%d:%i' "$STATE_DIR")
  read -r fdid owner mode ftype < <(stat -Lc '%d:%i %u %a %F' /dev/fd/9)
  [[ $pathid == "$fdid" ]] || die "$STATE_DIR is a symlink; refusing"
  [[ $ftype == directory ]] || die "$STATE_DIR is not a directory"
  [[ $owner == "$(id -u)" ]] || die "$STATE_DIR is not owned by you"
  [[ $mode == 700 ]] || chmod 700 /dev/fd/9
  DIR=/dev/fd/9
  ITEMS="$DIR/items.json"
  NOTES="$DIR/notes.json"
}

lock_shared() { flock -s 9; }
lock_exclusive() { flock -x 9; }
unlock() { flock -u 9; }

EMPTY_STORE='{"version":1,"nextId":1,"items":[],"archive":[]}'
EMPTY_NOTES='[]'

# Read one store file into the named variable. A missing file is the given
# empty value; a file that is not a private regular file of ours, is
# oversized, or does not parse as the schema is an error, never something to
# silently overwrite.
#   load_file <path> <max bytes> <validator> <empty> <varname>
load_file() {
  local path="$1" max="$2" validator="$3" empty="$4" name
  local -n out="$5"
  name=${path##*/}
  if [[ ! -e $path && ! -L $path ]]; then
    out=$empty
    return
  fi
  # Type-check the name before opening: a FIFO would block the open itself,
  # and inside an exclusive lock that hang would wedge every other caller.
  [[ ! -L $path && -f $path ]] || die "$name is not a regular file; refusing"
  exec 8<"$path" || die "cannot open $name"
  local pathid fdid owner links size ftype
  pathid=$(stat -c '%d:%i' "$path")
  read -r fdid owner links size ftype < <(stat -Lc '%d:%i %u %h %s %F' /dev/fd/8)
  [[ $pathid == "$fdid" ]] || die "$name is a symlink; refusing"
  [[ $ftype == "regular file" ]] || die "$name is not a regular file"
  [[ $owner == "$(id -u)" ]] || die "$name is not owned by you"
  [[ $links == 1 ]] || die "$name has extra hard links; refusing"
  ((size <= max)) || die "$name exceeds $max bytes; refusing"
  out=$(head -c "$max" <&8)
  exec 8<&-
  "$validator" <<<"$out" || die "$name is corrupt or not in the expected shape; move it aside"
}

# Every reminder command works on STORE, the validated content of items.json.
load_store() { load_file "$ITEMS" "$MAX_STORE_BYTES" validate_store "$EMPTY_STORE" STORE; }
# Note commands work on NOTE_STORE, from notes.json. Nothing else loads it.
load_notes() { load_file "$NOTES" "$MAX_NOTES_BYTES" validate_notes "$EMPTY_NOTES" NOTE_STORE; }

validate_store() {
  jq -e '
    def item: type == "object"
      and (.id | type == "number")
      and (.text | type == "string")
      and (.created | type == "number")
      and (.notified == null or (.notified | type == "boolean"))
      and (.due == null or (.due | type == "number" and . >= 0 and . < 1099511627776));
    type == "object"
    and .version == 1
    and (.nextId | type == "number")
    and (.items | type == "array" and all(item))
    and (.archive | type == "array" and all(item))
  ' >/dev/null 2>&1
}

validate_notes() {
  jq -e --argjson max "$MAX_NOTES" '
    def note: type == "object"
      and (.id | type == "number" and . >= 1 and . <= $max)
      and (.title | type == "string")
      and (.body | type == "string")
      and (.created | type == "number")
      and (.updated | type == "number");
    type == "array" and all(note) and length <= $max
  ' >/dev/null 2>&1
}

# Apply a jq filter to a store and replace its file atomically: private temp
# file in the anchored directory, data synced, then rename. Held under the
# exclusive lock taken by the caller, so read-modify-write cannot interleave.
#   write_file <path> <max bytes> <validator> <varname> <jq args...>
write_file() {
  local path="$1" max="$2" validator="$3" tmp
  local -n store="$4"
  shift 4
  tmp=$(mktemp "$DIR/.${path##*/}.XXXXXX")
  trap 'rm -f "$tmp"' EXIT
  if jq "$@" <<<"$store" >"$tmp" && "$validator" <"$tmp" \
     && (($(stat -c %s "$tmp") <= max)); then
    sync -d "$tmp"
    mv -T "$tmp" "$path"
    store=$(<"$path")
  else
    rm -f "$tmp"
    die "internal error: refusing to write an invalid store"
  fi
  trap - EXIT
}

apply() { write_file "$ITEMS" "$MAX_STORE_BYTES" validate_store STORE "$@"; }
apply_notes() { write_file "$NOTES" "$MAX_NOTES_BYTES" validate_notes NOTE_STORE "$@"; }

# --- input -------------------------------------------------------------------

check_len() {
  local what="$1" value="$2" max="$3"
  ((${#value} <= max)) || die "$what is too long (max $max characters)"
}

check_id() {
  [[ $1 =~ ^[0-9]+$ ]] && ((${#1} <= MAX_ID_DIGITS)) || die "\"$1\" is not an item id"
}

# Control characters never belong in an item: they would break the one-line
# list view and the notification body.
clean_text() { printf '%s' "${1//[[:cntrl:]]/ }"; }

# A note body is multi-line by design, so newline and tab stay; every other
# control character goes.
clean_body() { printf '%s' "$1" | tr -d '\000-\010\013-\037\177'; }

check_slot() {
  [[ $1 =~ ^[0-9]{1,${#MAX_NOTES}}$ ]] && (($1 >= 1 && $1 <= MAX_NOTES)) || die "\"$1\" is not a note number (1-$MAX_NOTES)"
}

# --- time --------------------------------------------------------------------

# Resolve a natural-language expression to an epoch. GNU date already
# understands "fri 2pm", "next tuesday 14:00", "2 weeks", "sep 3" - there is no
# parser to write here. The expression is passed as a single argv element, so
# arbitrary user text is never shell-evaluated.
resolve_when() {
  local expr="${1:-}" out
  [[ -z ${expr// /} ]] && return 1
  out=$(date -d "$expr" +%s 2>/dev/null) || return 1
  [[ $out =~ ^[0-9]+$ ]] || return 1
  echo "$out"
}

# Durations for snooze: bare "2h" style shorthand, otherwise anything date -d
# takes ("tomorrow 9am" is a legitimate snooze target).
resolve_snooze() {
  local expr="${1:-}"
  if [[ $expr =~ ^([0-9]{1,7})([smhdw])$ ]]; then
    local n=${BASH_REMATCH[1]} unit=${BASH_REMATCH[2]}
    case $unit in
    s) expr="+$n seconds" ;;
    m) expr="+$n minutes" ;;
    h) expr="+$n hours" ;;
    d) expr="+$n days" ;;
    w) expr="+$n weeks" ;;
    esac
  fi
  resolve_when "$expr"
}

when_text() { date -d "@$1" +'%a %-d %b %H:%M'; }

# Coarse relative delta. Deliberately imprecise past a day - "in 3d" is the
# useful fact, not "in 3d 4h 12m".
human_delta() {
  local s=$1 sign="in "
  ((s < 0)) && {
    sign=""
    s=$((-s))
  }
  local out
  if ((s < 60)); then out="${s}s"
  elif ((s < 3600)); then out="$((s / 60))m"
  elif ((s < 86400)); then out="$((s / 3600))h $(((s % 3600) / 60))m"
  elif ((s < 604800)); then out="$((s / 86400))d $(((s % 86400) / 3600))h"
  else out="$((s / 604800))w $(((s % 604800) / 86400))d"; fi
  [[ -z $sign ]] && echo "$out ago" || echo "${sign}${out}"
}

# Split "text @ when" on the LAST " @ ". No delimiter means a plain to-do.
split_input() {
  local input
  input=$(clean_text "$1")
  if [[ $input == *" @ "* ]]; then
    ITEM_TEXT="${input%" @ "*}"
    ITEM_WHEN="${input##*" @ "}"
  else
    ITEM_TEXT="$input"
    ITEM_WHEN=""
  fi
}

# --- notification ------------------------------------------------------------

# Notifications only exist inside a running shell. Without one, the sweeper must
# NOT mark items notified - it leaves them for the next sweep so the catch-up
# path can group them once you are actually back.
shell_running() { pgrep -x quickshell >/dev/null 2>&1 9<&-; }

# omarchy-notification-send takes the body positionally but still recognizes a
# body that is exactly one of its flag words; a leading space keeps item text
# like "--exec" or "-g" content rather than an option. fd 9 is the lock, and
# the notification daemon may leave a detached child behind, so it is closed
# for this call: nothing outside rem may ever hold the store lock.
notify() {
  local title="$1" body="${2:-}"
  [[ $body == -* ]] && body=" $body"
  omarchy-notification-send -g "$GLYPH" "$title" "$body" --exec rem show-overlay >/dev/null 2>&1 9<&- || true
}

# --- commands ----------------------------------------------------------------

cmd_add() {
  local input="$*" due=null when_desc="no due time"
  [[ -z ${input// /} ]] && die "nothing to add"
  check_len "input" "$input" "$MAX_INPUT"

  split_input "$input"
  if [[ -n $ITEM_WHEN ]]; then
    due=$(resolve_when "$ITEM_WHEN") || die "could not understand time \"$ITEM_WHEN\""
    when_desc="$(when_text "$due") ($(human_delta $((due - $(date +%s)))))"
  fi

  [[ -z ${ITEM_TEXT// /} ]] && die "an item needs text"
  check_len "item text" "$ITEM_TEXT" "$MAX_TEXT"

  lock_exclusive
  load_store
  (($(jq '.items | length' <<<"$STORE") < MAX_ITEMS)) || die "list is full ($MAX_ITEMS items); finish something first"
  apply --arg text "$ITEM_TEXT" --argjson due "$due" --argjson now "$(date +%s)" '
    .items += [{id: .nextId, text: $text, created: $now, due: $due, notified: false}]
    | .nextId += 1
  '
  echo "added: $ITEM_TEXT — $when_desc"
}

# Sorted view: overdue first, then upcoming by due, then undated by age. Text is
# clipped and the list capped here so no consumer sees more than the limits.
sorted_items() {
  jq --argjson now "$(date +%s)" --argjson maxText "$MAX_TEXT" --argjson maxItems "$MAX_ITEMS" '
    .items
    | map(. + {overdue: (.due != null and .due <= $now), text: .text[:$maxText]})
    | sort_by(if .overdue then 0 elif .due != null then 1 else 2 end,
              (.due // .created))
    | .[:$maxItems]
  ' <<<"$STORE"
}

cmd_ls() {
  lock_shared
  load_store
  local now
  now=$(date +%s)

  if [[ ${1:-} == "--json" ]]; then
    sorted_items | jq -c '
      {
        count: length,
        overdue: (map(select(.overdue)) | length),
        items: map({
          id, text, due, overdue,
          when: (if .due == null then "" else (.due | todate) end)
        })
      }
      | . + {
          active: (.count > 0),
          tooltip: (if .count == 0 then "No reminders"
                    elif .overdue > 0 then "\(.overdue) overdue, \(.count) open"
                    else "\(.count) open" end)
        }
    '
    return
  fi

  local id text due overdue any=0
  while IFS=$'\t' read -r id text due overdue; do
    any=1
    if [[ $due == "null" ]]; then
      printf '  %-3s %-9s %-18s %s\n' "$id" "-" "" "$text"
    elif [[ $overdue == "true" ]]; then
      printf '  %-3s %-9s %-18s %s\n' "$id" "OVERDUE" "$(when_text "$due")" "$text"
    else
      printf '  %-3s %-9s %-18s %s\n' "$id" "$(human_delta $((due - now)))" "$(when_text "$due")" "$text"
    fi
  done < <(sorted_items | jq -r '.[] | [.id, .text, (.due // "null"), .overdue] | @tsv')

  ((any)) || echo "  nothing open"
}

# done and rm are the same move with a different outcome recorded, so that the
# archive can answer "what did I finish" separately from "what did I abandon".
# The archive is trimmed to the newest MAX_ARCHIVE on every close.
close_items() {
  local outcome="$1"
  shift
  [[ $# -eq 0 ]] && die "need at least one id"
  local id
  for id in "$@"; do check_id "$id"; done
  local ids
  ids=$(printf '%s\n' "$@" | jq -R 'tonumber' | jq -sc .)

  lock_exclusive
  load_store
  local before after
  before=$(jq '.items | length' <<<"$STORE")
  apply --argjson ids "$ids" --arg outcome "$outcome" --argjson now "$(date +%s)" --argjson maxArchive "$MAX_ARCHIVE" '
    .archive += (.items | map(select(.id as $i | $ids | index($i)))
                        | map(. + {closed: $now, outcome: $outcome}))
    | .archive |= (sort_by(.closed) | .[-$maxArchive:])
    | .items |= map(select(.id as $i | ($ids | index($i)) | not))
  '
  after=$(jq '.items | length' <<<"$STORE")
  echo "$outcome: $((before - after)) item(s)"
}

cmd_snooze() {
  local id="${1:-}" spec="${2:-}"
  [[ -z $id || -z $spec ]] && {
    echo "Usage: rem snooze <id> <duration>" >&2
    return 1
  }
  check_id "$id"
  check_len "duration" "$spec" "$MAX_INPUT"

  local due
  due=$(resolve_snooze "$spec") || die "could not understand duration \"$spec\""

  lock_exclusive
  load_store
  apply --argjson id "$id" --argjson due "$due" '
    .items |= map(if .id == $id then . + {due: $due, notified: false} else . end)
  '
  echo "snoozed $id until $(when_text "$due")"
}

# Undo exists because Enter on a filtered list is one keystroke away from
# completing the wrong thing.
cmd_undo() {
  lock_exclusive
  load_store
  local last
  last=$(jq -r '.archive | if length == 0 then "" else (sort_by(.closed) | last | .text) end' <<<"$STORE")
  [[ -z $last ]] && {
    echo "rem: nothing to undo"
    return 0
  }
  (($(jq '.items | length' <<<"$STORE") < MAX_ITEMS)) || die "list is full ($MAX_ITEMS items); finish something first"

  apply --argjson maxText "$MAX_TEXT" '
    (.archive | sort_by(.closed) | last) as $item
    | .items += [$item | del(.closed, .outcome) | .text |= .[:$maxText]]
    | .archive |= map(select(. != $item))
  '
  echo "restored: $last"
}

cmd_sweep() {
  lock_shared
  load_store
  local now
  now=$(date +%s)

  local pending
  pending=$(jq -c --argjson now "$now" --argjson maxText "$MAX_TEXT" '
    [.items[] | select(.due != null and .notified != true and .due <= $now)
              | .text |= .[:$maxText]]
  ' <<<"$STORE")

  local count
  count=$(jq 'length' <<<"$pending")
  ((count == 0)) && return 0

  # No shell means no notification. Leave everything unmarked and try again
  # next minute - that is exactly how a multi-day absence turns into one
  # grouped catch-up rather than a silent loss.
  shell_running || return 0

  local max_late
  max_late=$(jq --argjson now "$now" 'map($now - .due) | max' <<<"$pending")

  if ((count == 1 && max_late <= AWAY_THRESHOLD)); then
    notify "Reminder" "$(jq -r '.[0].text' <<<"$pending")"
  else
    local body title
    body=$(jq -r --argjson max "$MAX_NOTIFY_LINES" '
      (.[:$max] | map("• \(.text)"))
      + (if length > $max then ["…and \(length - $max) more"] else [] end)
      | join("\n")
    ' <<<"$pending")
    if ((max_late > AWAY_THRESHOLD)); then
      title="$count reminder(s) came due while you were away"
    else
      title="$count reminders due"
    fi
    notify "$title" "$body"
  fi

  lock_exclusive
  load_store
  apply --argjson now "$now" '
    .items |= map(if (.due != null and .notified != true and .due <= $now)
                  then . + {notified: true} else . end)
  '
}

cmd_show() {
  local body total
  body=$(cmd_ls)
  total=$(wc -l <<<"$body")
  if ((total > MAX_NOTIFY_LINES)); then
    body="$(head -n "$MAX_NOTIFY_LINES" <<<"$body")"$'\n'"  …and $((total - MAX_NOTIFY_LINES)) more"
  fi
  notify "Reminders" "$body"
}

# Live preview for the overlay: resolve an expression without committing to it.
cmd_parse() {
  local input="$*"
  if ((${#input} > MAX_INPUT)); then
    jq -cn --argjson max "$MAX_INPUT" '{ok: false, dated: false, preview: "too long (max \($max) characters)"}'
    return
  fi
  split_input "$input"

  if ((${#ITEM_TEXT} > MAX_TEXT)); then
    jq -cn --argjson max "$MAX_TEXT" '{ok: false, dated: false, preview: "too long (max \($max) characters)"}'
    return
  fi

  if [[ -z $ITEM_WHEN ]]; then
    jq -cn --arg text "$ITEM_TEXT" '{ok: true, dated: false, text: $text, preview: "no due time — to-do only"}'
    return
  fi

  local due
  if ! due=$(resolve_when "$ITEM_WHEN"); then
    jq -cn --arg when "$ITEM_WHEN" '{ok: false, dated: true, preview: "can’t read “\($when)”"}'
    return
  fi

  jq -cn --arg text "$ITEM_TEXT" --argjson due "$due" \
    --arg preview "$(when_text "$due")  ($(human_delta $((due - $(date +%s)))))" \
    '{ok: true, dated: true, text: $text, due: $due, preview: $preview}'
}

cmd_overlay() { omarchy-shell shell summon gumbledore.reminders "{}" >/dev/null 2>&1 || true; }

# --- notes -------------------------------------------------------------------

# Round-trip a note through $EDITOR: title on the first line, a blank line,
# then the body, like a commit message. $EDITOR is run through the shell so a
# value with arguments (omarchy's own is `omarchy-launch-editor --inline`)
# works, the way git does it. Sets NOTE_TITLE and NOTE_BODY; returns 1 when the
# file comes back empty, which is how you cancel. The lock fd is closed for the
# editor, and the caller must not hold the lock while a human types.
edit_note() {
  local title="$1" body="$2" dir file
  [[ -n ${EDITOR:-} ]] || die "set \$EDITOR to write notes from the command line"
  dir=$(mktemp -d)
  trap 'rm -rf "$dir"' EXIT
  file="$dir/note.txt"
  if [[ -n $title || -n $body ]]; then
    printf '%s\n\n%s\n' "$title" "$body" >"$file"
  else
    : >"$file"
  fi
  sh -c "$EDITOR \"\$@\"" "$EDITOR" "$file" 9<&- || die "editor exited with an error; note unchanged"
  parse_note_file "$file"
  rm -rf "$dir"
  trap - EXIT
  [[ -n $NOTE_TITLE ]]
}

# Title is everything before the first blank line (flattened to one line);
# body is everything after it, minus trailing newlines. A body with no title
# line is not a note.
parse_note_file() {
  local content
  # Read no more than one note could ever be; the caps are checked after.
  content=$(head -c $((MAX_NOTE_TITLE + MAX_NOTE_BODY + 16)) "$1")
  if [[ $content == *$'\n\n'* ]]; then
    NOTE_TITLE=${content%%$'\n\n'*}
    NOTE_BODY=${content#*$'\n\n'}
  else
    NOTE_TITLE=$content
    NOTE_BODY=""
  fi
  NOTE_TITLE=$(clean_text "$NOTE_TITLE")
  NOTE_TITLE="${NOTE_TITLE#"${NOTE_TITLE%%[![:space:]]*}"}"
  NOTE_TITLE="${NOTE_TITLE%"${NOTE_TITLE##*[![:space:]]}"}"
  NOTE_BODY=$(clean_body "$NOTE_BODY")
}

check_note() {
  [[ -n ${NOTE_TITLE// /} ]] || die "a note needs a title"
  check_len "note title" "$NOTE_TITLE" "$MAX_NOTE_TITLE"
  check_len "note body" "$NOTE_BODY" "$MAX_NOTE_BODY"
}

# Slot order, with title and body clipped so no consumer sees past the caps.
sorted_notes() {
  jq --argjson maxTitle "$MAX_NOTE_TITLE" --argjson maxBody "$MAX_NOTE_BODY" '
    sort_by(.id) | map(. + {title: .title[:$maxTitle], body: .body[:$maxBody]})
  ' <<<"$NOTE_STORE"
}

cmd_note_ls() {
  lock_shared
  load_notes
  if [[ ${1:-} == "--json" ]]; then
    sorted_notes | jq -c '{count: length, notes: map({id, title, body, created, updated})}'
    return
  fi
  local id updated title any=0
  while IFS=$'\t' read -r id updated title; do
    any=1
    printf '  %-3s %-18s %s\n' "$id" "$(when_text "$updated")" "$title"
  done < <(sorted_notes | jq -r '.[] | [.id, .updated, .title] | @tsv')
  ((any)) || echo "  no notes"
}

# No args: editor, empty file. Title only: editor with the title filled in.
# Title and body: written as given, no editor - the form scripts use.
cmd_note_add() {
  (($# <= 2)) || die "usage: rem note add [title] [body]"
  if (($# == 2)); then
    NOTE_TITLE=$(clean_text "$1")
    NOTE_BODY=$(clean_body "$2")
  else
    check_len "note title" "${1:-}" "$MAX_NOTE_TITLE"
    edit_note "$(clean_text "${1:-}")" "" || { echo "rem: empty note, nothing added"; return 0; }
  fi
  check_note

  lock_exclusive
  load_notes
  (($(jq 'length' <<<"$NOTE_STORE") < MAX_NOTES)) || die "you have $MAX_NOTES notes, which is the limit; remove one first"
  apply_notes --arg title "$NOTE_TITLE" --arg body "$NOTE_BODY" --argjson now "$(date +%s)" --argjson max "$MAX_NOTES" '
    (([range(1; $max + 1)] - map(.id)) | first) as $slot
    | . + [{id: $slot, title: $title, body: $body, created: $now, updated: $now}]
    | sort_by(.id)
  '
  echo "added note $(jq -r --arg t "$NOTE_TITLE" 'map(select(.title == $t)) | max_by(.created) | .id' <<<"$NOTE_STORE"): $NOTE_TITLE"
}

note_json() {
  jq -e --argjson id "$1" 'map(select(.id == $id)) | first // empty' <<<"$NOTE_STORE" \
    || die "no note in slot $1"
}

cmd_note_edit() {
  local id="${1:-}"
  [[ -n $id ]] || die "usage: rem note edit <n>"
  check_slot "$id"
  [[ -n ${EDITOR:-} ]] || die "set \$EDITOR to write notes from the command line"

  lock_shared
  load_notes
  local current
  current=$(note_json "$id")
  unlock
  edit_note "$(jq -r .title <<<"$current")" "$(jq -r .body <<<"$current")" \
    || { echo "rem: empty file, note $id unchanged"; return 0; }
  check_note

  lock_exclusive
  load_notes
  note_json "$id" >/dev/null
  apply_notes --argjson id "$id" --arg title "$NOTE_TITLE" --arg body "$NOTE_BODY" --argjson now "$(date +%s)" '
    map(if .id == $id then . + {title: $title, body: $body, updated: $now} else . end)
  '
  echo "updated note $id: $NOTE_TITLE"
}

cmd_note_show() {
  local id="${1:-}"
  [[ -n $id ]] || die "usage: rem note show <n>"
  check_slot "$id"
  lock_shared
  load_notes
  note_json "$id" | jq -r --argjson maxTitle "$MAX_NOTE_TITLE" --argjson maxBody "$MAX_NOTE_BODY" \
    '"\(.title[:$maxTitle])\n\n\(.body[:$maxBody])"'
}

cmd_note_rm() {
  local id="${1:-}"
  [[ -n $id ]] || die "usage: rem note rm <n>"
  check_slot "$id"
  lock_exclusive
  load_notes
  note_json "$id" >/dev/null
  apply_notes --argjson id "$id" 'map(select(.id != $id))'
  echo "removed note $id"
}

cmd_note() {
  case ${1:-ls} in
  ls | list) shift || true; cmd_note_ls "${1:-}" ;;
  add) shift; cmd_note_add "$@" ;;
  edit) shift; cmd_note_edit "$@" ;;
  show) shift; cmd_note_show "$@" ;;
  rm | drop) shift; cmd_note_rm "$@" ;;
  *) die "unknown note command \"$1\" (ls, add, edit, show, rm)" ;;
  esac
}

usage() {
  cat <<'EOF'
Usage:
  rem                          list open items
  rem <minutes> [message]      quick timer (compatible with `omarchy reminder`)
  rem add <text> [@ <when>]    add an item; no "@" means a to-do with no due time
  rem ls [--json]              list
  rem done <id>...             complete (archived, undoable)
  rem rm <id>...               drop (archived as abandoned)
  rem snooze <id> <duration>   push the due time out (2h, 3d, "tomorrow 9am")
  rem undo                     restore the most recently closed item
  rem show                     list as a notification
  rem sweep                    fire anything due (called by the timer)
  rem parse <text>             resolve "@ when" without adding (used by the overlay)

  rem note                     list notes (slot, last edited, title)
  rem note add [title] [body]  new note; fewer than two arguments opens $EDITOR
  rem note edit <n>            open note <n> in $EDITOR
  rem note show <n>            print note <n>
  rem note rm <n>              remove note <n>; the slot is reused
  rem note ls --json           machine-readable

Notes are numbered 1-50 by slot; a new note takes the lowest free slot.

Time expressions go straight to `date -d`: "fri 2pm", "next tuesday 14:00",
"2 weeks", "sep 3", "tomorrow 9am".
EOF
}

# Commands that touch the store open it first; parse, help and show-overlay
# never need the state directory at all.
case ${1:-ls} in
add | ls | list | done | rm | drop | snooze | undo | sweep | show | note) open_state_dir ;;
esac

case ${1:-ls} in
add)
  shift
  cmd_add "$@"
  ;;
ls | list)
  shift || true
  cmd_ls "${1:-}"
  ;;
done)
  shift
  close_items done "$@"
  ;;
rm | drop)
  shift
  close_items dropped "$@"
  ;;
snooze)
  shift
  cmd_snooze "$@"
  ;;
undo)
  cmd_undo
  ;;
sweep)
  cmd_sweep
  ;;
show)
  cmd_show
  ;;
show-overlay)
  cmd_overlay
  ;;
parse)
  shift
  cmd_parse "$@"
  ;;
note)
  shift
  cmd_note "$@"
  ;;
-h | --help | help)
  usage
  ;;
*)
  # Bare minutes keeps the muscle memory from `omarchy reminder 15 "..."`.
  if [[ ${1:-} =~ ^[0-9]{1,7}$ ]]; then
    minutes=$1
    shift || true
    message="$*"
    [[ -z $message ]] && message="Your $minutes minutes are up"
    open_state_dir
    cmd_add "$message @ +$minutes minutes"
  else
    usage
    exit 1
  fi
  ;;
esac
